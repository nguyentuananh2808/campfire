POSTGRES_DB=campfire
POSTGRES_USER=campfire
POSTGRES_PASSWORD=replace-with-a-long-local-secret
ConnectionStrings__Campfire=Host=localhost;Port=5433;Database=campfire;Username=campfire;Password=replace-with-a-long-local-secret
LIVEKIT_API_KEY=replace-with-a-livekit-key
LIVEKIT_API_SECRET=replace-with-a-long-livekit-secret
LiveKit__PublicUrl=wss://tamsuvoinhau.cloud/livekit
LiveKit__ApiUrl=http://localhost:7880
LiveKit__ApiKey=replace-with-a-livekit-key
LiveKit__ApiSecret=replace-with-a-long-livekit-secret
Security__RequireHttps=true
AllowedHosts=tamsuvoinhau.cloud
DataProtection__KeysPath=/var/lib/campfire/data-protection-keys
# Add only the private IP address of a trusted TLS reverse proxy when one is used.
# ReverseProxy__KnownProxies__0=10.0.1.10
