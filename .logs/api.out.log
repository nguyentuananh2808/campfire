d"},"SourceContext":"Microsoft.EntityFrameworkCore.Database.Command","RequestId":"0HNPCCRUT68L9:00000001","RequestPath":"/api/v1/stranger/matchmaking","ConnectionId":"0HNPCCRUT68L9"}
